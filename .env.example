# ==============================================================================
# SoftTech Solutions (STS) - Environment Variables Configuration Template
# Copy this file to `.env` or `.env.local` and fill in the actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Prisma ORM & PostgreSQL)
# ------------------------------------------------------------------------------
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Example Local: postgresql://postgres:postgres@localhost:5432/softechsol_db?schema=public
# Example Remote: postgresql://dbuser:mypassword@72.61.146.192:5432/softechsol_db?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/softechsol_db?schema=public"

# ------------------------------------------------------------------------------
# 2. APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
# Node environment mode: 'development' or 'production'
NODE_ENV="development"
NEXT_PUBLIC_NODE_ENV="dev"

# Base public URL of the website
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 3. NEXTAUTH (Admin Dashboard Authentication)
# ------------------------------------------------------------------------------
# Canonical URL used for NextAuth redirects and CSRF handling
# In local: http://localhost:3000
# In production: https://softechsol.com (or https://admin.softechsol.com)
NEXTAUTH_URL="http://localhost:3000"

# Strong secret key for signing JWT session tokens and encryption.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-generated-super-secret-jwt-key-min-32-chars"

# ------------------------------------------------------------------------------
# 4. EMAIL / SMTP CONFIGURATION (Contact Us & Career Submissions)
# ------------------------------------------------------------------------------
# Outgoing SMTP server details (e.g. GoDaddy, Google Workspace, SendGrid, Mailgun)
SMTP_HOST="smtpout.secureserver.net"
SMTP_PORT=587
# Set to 'true' for port 465 (SSL), or 'false' for 587/STARTTLS
SMTP_SECURE=false
SMTP_USER="hr@softechsol.com"
SMTP_PASSWORD="your-smtp-account-password"
SMTP_FROM="hr@softechsol.com"
SMTP_DOMAIN="softechsol.com"

# Business & HR contact settings
HR_EMAIL="hr@softechsol.com"
COMPANY_NAME="SoftTech Solutions"

# ------------------------------------------------------------------------------
# 5. GOOGLE RECAPTCHA (Form Spam Prevention)
# ------------------------------------------------------------------------------
# Client-side public key (rendered on Contact / Career forms)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY="your-recaptcha-site-key-here"

# Server-side secret key (used to verify captcha tokens via Google API)
RECAPTCHA_SECRET_KEY="your-recaptcha-secret-key-here"

# ------------------------------------------------------------------------------
# 6. PHYSICAL ASSET STORAGE (Uploaded Media / Gallery)
# ------------------------------------------------------------------------------
# Optional: Absolute directory on host server where uploaded assets are stored.
# Leave empty for local development (defaults to <project_root>/public/storage).
# On Linux production server: /var/www/softechsol/public/storage
STORAGE_BASE_PATH=""

# Public URL route prefix for accessing storage assets (default: /storage)
STORAGE_URL_PREFIX="/storage"
